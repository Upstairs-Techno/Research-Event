# Edge Function secrets - NEVER commit or put in frontend code.
# Set with:  supabase secrets set --env-file supabase/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# mock = placeholder scores for development, http = call real vendor APIs
ORIGINALITY_MODE=mock
PLAGIARISM_API_URL=
PLAGIARISM_API_KEY=
AI_DETECTION_API_URL=
AI_DETECTION_API_KEY=
